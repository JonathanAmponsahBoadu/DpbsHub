# Copy this file to .env (already git-ignored — never commit real keys) to
# auto-seed the on-device AI key vault during `flutter run`, so debug builds
# don't need the keys retyped into the app after every reinstall.
#
# Usage:  flutter run --dart-define-from-file=.env
#
# This ONLY affects debug builds (see lib/core/ai/dev_key_seed.dart) — a
# release build ignores these entirely, and real users always add their own
# keys through Settings → AI Providers, never through this file.
GEMINI_API_KEY=
GROQ_API_KEY=
