rules_version = '2';

// DpbsHub Firestore security rules.
//
// Every document this app writes lives under users/{uid}/... (see
// lib/data/sync/sync_service.dart) — this single rule restricts every one
// of those subtrees to the signed-in user who owns them. No document is
// ever readable or writable by anyone else, and unauthenticated requests
// are rejected outright.
//
// To apply: Firebase console → Firestore Database → Rules tab → paste this
// entire file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
